# Backend
DATABASE_URL=postgresql+psycopg://cloudopt:cloudopt@localhost:5433/cloudopt
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# Seconds of wall-clock time per replayed 5-minute slot (5 => 60x acceleration)
REPLAY_SECONDS_PER_SLOT=5
# Optional: natural-language explanations. Without a key a deterministic template is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Spend cap: LLM calls per hour (beyond it, explanations use the deterministic template)
OPENAI_MAX_CALLS_PER_HOUR=120
# Initial admin account created on first start
SEED_ADMIN_EMAIL=admin@cloudopt.dev
SEED_ADMIN_PASSWORD=change-me
